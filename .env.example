# ===== SERVER =====
# Secret untuk JWT — ganti dengan string random yang panjang!
JWT_SECRET=ganti-dengan-secret-random-yang-sangat-panjang

# Port server (Railway akan set ini otomatis)
PORT=3000

# ===== CLIENT (prefix VITE_) =====
# URL backend API (kosongkan jika client & server di domain yang sama)
VITE_API_URL=
